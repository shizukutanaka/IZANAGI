#!/bin/sh
# Pre-commit: the fast checks (format + lints). The full gate runs on push.
# Enable from the repository root with:  git config core.hooksPath .githooks
set -eu
cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: cargo fmt --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy"
cargo clippy --workspace --all-targets -- -D warnings

echo "pre-commit: ok"
